<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.optionscalculator.premarket-screener-alert</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PROJECT_ROOT__/scripts/automation/run_premarket_screener_alert.sh</string>
  </array>
  <!--
    Weekdays at 15:00 LOCAL (= UTC on this host) = 11:00 ET in EDT / 10:00 ET
    in EST — at least 30 minutes AFTER the 09:30 ET open in BOTH DST regimes.

    History of this number (Codex audit F6): the job first ran at 13:00
    (09:00 ET, pre-open) and alerted on a chain with no quotes — before the
    open yfinance returns bid=ask=0 and a placeholder IV around 1e-5 (ORCL
    2026-09-02, IV/RV 0.00 scored as maximally cheap vol). It was moved to
    14:30, which is 10:30 ET in EDT but exactly 09:30 ET — the opening bell —
    in EST, i.e. not yet stabilised quotes for a third of the year. 15:00 is
    the earliest whole hour that is post-open year-round.

    Entry timing within the session is not critical for this strategy (3-10 DTE
    pre-earnings), so the time is chosen for quote quality, not urgency.
    Weekends are omitted (Weekday 1-5): a Saturday alert would duplicate
    Friday's. Clear of every other job: exit resolver (12:30), forward
    collector (19:30), evidence cycle (21:30), watchdog (22:15), rotation
    (03:00), backup (04:00). This job only reads provider data and writes its
    own state file, so it cannot contend with the SQLite writers.
  -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Weekday</key><integer>1</integer>
      <key>Hour</key><integer>15</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>2</integer>
      <key>Hour</key><integer>15</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>3</integer>
      <key>Hour</key><integer>15</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>4</integer>
      <key>Hour</key><integer>15</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>5</integer>
      <key>Hour</key><integer>15</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
  </array>
  <key>StandardOutPath</key>
  <string>__HOME__/.options_calculator_pro/logs/premarket_screener_alert_launchd_stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.options_calculator_pro/logs/premarket_screener_alert_launchd_stderr.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>

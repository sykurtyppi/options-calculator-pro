# Options / quotes provider: yfinance (default, free, no greeks) |
# marketdata_app (paid, needs MARKETDATA_TOKEN) | ib_gateway (local IB Gateway/TWS)
OPTIONS_CALCULATOR_OPTIONS_PROVIDER=yfinance

# Interactive Brokers Gateway — only read when the provider above is ib_gateway.
# The gateway must be running and logged in; the app connects read-only.
# Ports: 4002 IB Gateway paper, 4001 IB Gateway live, 7497 TWS paper, 7496 TWS live.
IB_GATEWAY_HOST=127.0.0.1
IB_GATEWAY_PORT=4002
IB_GATEWAY_CLIENT_ID=17
# 1 live | 2 frozen | 3 delayed (free, ~15 min, no quote timestamps) | 4 delayed-frozen
IB_GATEWAY_MARKET_DATA_TYPE=3
IB_GATEWAY_TIMEOUT_SECONDS=10
IB_GATEWAY_QUOTE_SETTLE_SECONDS=15
# Optional: the .app bundle the com.optionscalculator.ib-gateway launchd job starts.
# Default: the newest "IB Gateway <version>.app" under ~/Applications or /Applications.
IB_GATEWAY_APP=

# MarketData.app API token — get yours at https://www.marketdata.app/
# 100,000 credits/day on paid plans. Free tier: 100 req/day.
MARKETDATA_TOKEN=your_token_here

# Alpha Vantage earnings calendar — best used as a cached bulk discovery feed.
# Official free-tier support currently documents up to 25 requests/day.
ALPHA_VANTAGE_API_KEY=

# Financial Modeling Prep — optional secondary calendar / confirmed-earnings source.
FMP_API_KEY=

# SEC EDGAR API user agent for confirmation lookups.
# Example: your-email@example.com options-calculator-pro/1.0
SEC_API_USER_AGENT=

# Nightly state backup destination (scripts/automation/run_state_backup.sh).
# Leave empty and archives land on the SAME disk as the state (no disaster
# recovery). Point it at an external drive or sync folder; preflight warns
# when it is unset, unmounted, or on the state's own disk.
OPTIONS_CALCULATOR_BACKUP_DIR=
OPTIONS_CALCULATOR_BACKUP_RETENTION=14

# Optional iMessage watchdog alerts for the daily evidence cycle.
# Use the phone number or Apple ID reachable from Messages on this Mac.
WATCHDOG_IMESSAGE_TO=

# CORS origins for the FastAPI backend (comma-separated)
OPTIONS_CALCULATOR_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional share-code auth for shared deployments
ENABLE_SHARE_AUTH=false
SHARE_PASSWORD=
SESSION_SECRET=change-me-in-env
